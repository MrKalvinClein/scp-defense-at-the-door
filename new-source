        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
})

MiscTab:Space()

MiscTab:Button({
    Title = "Server Hop",
    Icon = "shuffle",
    Justify = "Center",
    Callback = function()
        local HttpService = game:GetService("HttpService")
        local TeleportService = game:GetService("TeleportService")
        local PlaceId = game.PlaceId
        
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        
        if servers and servers.data then
            for _, server in pairs(servers.data) do
                if server.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                    break
                end
            end
        end
    end
})

MiscTab:Space()

MiscTab:Input({
    Title = "Keybind",
    Placeholder = "Enter keybind",
    Callback = function(text)
        if text and #text > 0 then
            if isMobile then
                WindUI:Notify({
                    Title = "Mobile Device",
                    Content = "You cant change keybind on mobile, use the open gui button instead",
                    Duration = 2,
                })
                return
            end
            
            if #text > 1 then
                WindUI:Notify({
                    Title = "Invalid Keybind",
                    Content = "You cant put a keybind that has more than 1 letter",
                    Duration = 2,
                })
                return
            end
            
            local keyName = string.upper(text)
            
            if keyName == "F" then
                WindUI:Notify({
                    Title = "Invalid Keybind",
                    Content = "This is already the default keybind",
                    Duration = 2,
                })
                return
            end
            
            if tonumber(keyName) then
                WindUI:Notify({
                    Title = "Invalid Keybind",
                    Content = "You cant put a number as a keybind",
                    Duration = 2,
                })
                return
            end
            
            local restrictedKeys = {"A", "S", "D", "W", "SPACE", "UP", "DOWN", "LEFT", "RIGHT", "ESCAPE", "LEFTSHIFT", "SHIFT", "LSHIFT"}
            if table.find(restrictedKeys, keyName) then
                WindUI:Notify({
                    Title = "Invalid Key",
                    Content = "You cant use movement keys",
                    Duration = 2,
                })
                return
            end
            
            local keyCode = Enum.KeyCode[keyName]
            if keyCode then
                Window:SetToggleKey(keyCode)
                currentKeybind = keyName
                
                Window:EditOpenButton({
                    Title = "Keybind: " .. keyName,
                    Icon = "grip",
                    CornerRadius = UDim.new(0,16),
                    StrokeThickness = 2,
                    OnlyMobile = false,
                    Enabled = true,
                    Draggable = false,
                })
                
                WindUI:Notify({
                    Title = "Keybind Updated",
                    Content = "Menu toggle keybind changed to: " .. keyName,
                    Duration = 2,
                })
            else
                WindUI:Notify({
                    Title = "Invalid Keybind",
                    Content = "Keybind '" .. text .. "' is not valid",
                    Duration = 2,
                })
            end
        end
    end
})

